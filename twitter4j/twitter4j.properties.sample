# Live Twitter4J mode uses environment variables rather than a credentials file:
#
# NASVEN_TWITTER_LIVE=true
# TWITTER_OAUTH_CONSUMER_KEY=
# TWITTER_OAUTH_CONSUMER_SECRET=
# TWITTER_OAUTH_ACCESS_TOKEN=
# TWITTER_OAUTH_ACCESS_TOKEN_SECRET=
#
# Without NASVEN_TWITTER_LIVE=true, the sample performs deterministic
# no-credential validation and does not contact Twitter.
